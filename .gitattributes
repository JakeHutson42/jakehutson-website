# These packages are checksum-addressed. Preserve their exact generated bytes
# on Windows and Linux rather than applying core.autocrlf conversions.
games/trials/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/trials/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Retain the upstream Planck bundle's final blank line as part of its checksum.
lib/planck/** -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
lib/three/0.180.0/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
